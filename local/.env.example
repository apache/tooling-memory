# Copy to local/.env and fill in. local/.env is ignored by git and read by make local-*.

# Your own provider keys. The egress or LiteLLM holds them; a harness never sees them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# The LiteLLM master key: mints virtual keys, never used by a client. Any sk- string.
LITELLM_MASTER_KEY=sk-local-master-change-me

# Postgres password for LiteLLM's own database.
POSTGRES_PASSWORD=litellm

# Where your memory root lives. Created by `make local-memory` if missing.
MEMORY_ROOT=/home/you/memory
